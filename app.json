{
  "expo": {
    "name": "Modo Mamado",
    "slug": "modo-mamado",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.felipemarin.modomamado",
      "buildNumber": "7",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.felipemarin.modomamado",
      "versionCode": 7,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/Quantico_400Regular.ttf",
              "./assets/fonts/Quantico_700Bold.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Quantico",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Quantico_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Quantico_700Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-status-bar",
      "expo-notifications"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "94e4688c-521e-4c03-ab71-bae71c5d6b21"
      }
    },
    "owner": "felipemarin"
  }
}
