{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "diagnostic": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_MINIMAL_DIAGNOSTIC": "1"
      },
      "ios": {
        "simulator": false
      }
    },
    "startup-minimal": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_STARTUP_MINIMAL_ENTRY": "1"
      }
    },
    "router-core": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ROUTER_ROOT_MINIMAL": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6812806239"
      }
    }
  }
}
